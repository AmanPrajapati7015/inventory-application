<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Cart</title>
    <link rel="stylesheet" href="/styles/index.css">
    <link rel="stylesheet" href="/styles/cart.css">
</head>
<body>
    <%- include('navbar') %>

    <section class="cart-container main">
        <% if (cart.length === 0) { %>
            <p>Your cart is empty.</p>
        <% } else { %>
            <div class="cart-list">
                <% let total = 0; %>
                <% cart.forEach(game => { %>
                    <% total += parseFloat(game.price); %>
                    <div class="cart-card">
                        <img src="<%= game.cover_img %>" alt="<%= game.name %>">
                        <div class="cart-details">
                            <h3><%= game.name %></h3>
                            <p>₹ <%= game.price %></p>
                            <p><strong>Publisher:</strong> <%= game.publisher %></p>
                            <p><strong>Rating:</strong> <%= game.rating %></p>
                            <p><strong>Release:</strong> <%= new Date(game.release_date).toLocaleDateString() %></p>
                        </div>
                        <form class="remove-form" action="cart/remove" method="POST">
                            <input type="hidden" name="game_id" value="<%= game.game_id %>">
                            <button type="submit" class="remove-btn">Remove</button>
                        </form>
                    </div>
                <% }); %>
            </div>

            <div class="cart-summary">
                <h2>Total: ₹ <%= total.toFixed(2) %></h2>
                <form action="cart/checkout" method="POST">
                    <button type="submit" class="buy-btn">Checkout</button>
                </form>
            </div>
        <% } %>
    </section>

    <%- include('footer') %>
</body>
</html>
